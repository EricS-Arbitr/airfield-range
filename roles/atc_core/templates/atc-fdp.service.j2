# {{ ansible_managed }}
[Unit]
Description=ATC Flight Data Processor (electronic flight strips)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ atc_user }}
ExecStart={{ atc_venv }}/bin/python {{ atc_fdp_dir }}/app.py --config {{ atc_fdp_dir }}/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
